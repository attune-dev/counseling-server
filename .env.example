# ==========================================
# 이 파일을 복사해서 .env 로 이름 변경 후 값을 채우세요
# cp .env.example .env
# ==========================================

# VAD
VAD_SILENCE_THRESHOLD=0.5
VAD_SAMPLE_RATE=16000
VAD_CHUNK_SAMPLES=512

# STT (Whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# LLM — EXAONE-3.5-7.8B (8-bit, ~8GB VRAM)
# 로컬 테스트 시: CBT_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
CBT_LLM_MODEL=LGAI-EXAONE/EXAONE-3.5-7.8B-Instruct
CBT_LLM_DEVICE=cuda

# 텍스트 감정 (BERT FP16, ~200MB VRAM)
TEXT_EMOTION_MODEL_PATH=models/text-emotion-final
TEXT_EMOTION_DEVICE=cuda

# 음성 감정 (Wav2Vec2)
AUDIO_EMOTION_DEVICE=cpu
VOICE_EMOTION_MODEL_PATH=models/voice-emotion-final

# OpenAI API (GPT-4o-mini 플랜 생성 + 단계 요약용)
OPENAI_API_KEY=

# 서버
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
